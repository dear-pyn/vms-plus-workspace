{
  "name": "vms-plus-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3020",
    "build": "node tools/validate.mjs && next build --webpack && node tools/finish-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "node tools/validate.mjs",
    "plugins:build": "node tools/build-plugins.mjs",
    "preview": "python3 -m http.server 3020 --bind 127.0.0.1 --directory out"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19"
  }
}
